{
  "name": "storycraft-skills",
  "version": "1.0.0",
  "description": "Professional AI agent skills for novel writing craft — universal multiplatform compatibility",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/skill-structure.test.mjs && node scripts/validate-skills.mjs",
    "validate": "node scripts/validate-skills.mjs",
    "bump-version": "bash scripts/bump-version.sh"
  },
  "keywords": [
    "pi-package",
    "skills",
    "novel-writing",
    "creative-writing",
    "agent-skills",
    "cursor",
    "claude",
    "codex",
    "antigravity",
    "fiction",
    "storytelling"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/storycraft.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "author": "Luvi Aprilyansyah Gabriel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leapwithluvi/storycraft-skills"
  },
  "engines": {
    "node": ">=18.0.0"
  }
